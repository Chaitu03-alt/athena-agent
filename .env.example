# Personal Adaptive AI Agent - Environment Configuration

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_MODEL_PRIMARY=claude-sonnet-4-6
LLM_MODEL_LIGHT=claude-haiku-4-5-20251001

# Optional OpenAI-Compatible Fallback
OPENAI_API_KEY=
OPENAI_BASE_URL=

# -----------------------------------------------------------------------------
# Embedding Provider Configuration
# -----------------------------------------------------------------------------
# Options: hosted | local
EMBEDDING_MODE=hosted
VOYAGE_API_KEY=your_voyage_api_key_here

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL 16)
# -----------------------------------------------------------------------------
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent_secret_password
POSTGRES_DB=personal_agent
POSTGRES_PORT=5432

# In Docker:
DATABASE_URL=postgresql://agent:agent_secret_password@postgres:5432/personal_agent
# Local host (outside Docker):
# DATABASE_URL=postgresql://agent:agent_secret_password@localhost:5432/personal_agent
# SQLite single-machine alternative:
# DATABASE_URL=sqlite:///./data/agent.db

# -----------------------------------------------------------------------------
# Vector Database Configuration (Qdrant)
# -----------------------------------------------------------------------------
# In Docker:
QDRANT_URL=http://qdrant:6333
# Local host (outside Docker):
# QDRANT_URL=http://localhost:6333
QDRANT_GRPC_PORT=6334

# -----------------------------------------------------------------------------
# Security & Access Control
# -----------------------------------------------------------------------------
# Bearer token for API and Web UI access (single-user local security)
APP_ACCESS_TOKEN=change-me-to-a-secure-random-token

# -----------------------------------------------------------------------------
# Agent Sandbox & Safety Guardrails
# -----------------------------------------------------------------------------
# Options: subprocess | docker
SANDBOX_MODE=subprocess
CONFIRM_DESTRUCTIVE_ACTIONS=true

# -----------------------------------------------------------------------------
# Server & Logging
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info
